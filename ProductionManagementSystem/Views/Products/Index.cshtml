@{
    ViewData["Title"] = "Управление продуктами";
}
@model List<Product>

<div class="card">
    <h2>Продукты</h2>
    
    <form method="get" style="margin-bottom:1rem">
        <input type="text" name="search" placeholder="Поиск..." value="@ViewBag.SelectedCategory" style="padding: 5px; margin-right: 10px;" />
        <select name="category" style="padding: 5px; margin-right: 10px;">
            <option value="">Все категории</option>
            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat" selected="@(ViewBag.SelectedCategory == cat)">@cat</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Фильтр</button>
        <a href="/Products/Create" class="btn btn-success" style="margin-left: 10px;">Создать продукт</a>
    </form>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #f8f9fa;">
                <th style="padding: 10px; text-align: left;">Название</th>
                <th style="padding: 10px; text-align: left;">Время производства (мин/шт)</th>
                <th style="padding: 10px; text-align: left;">Категория</th>
                <th style="padding: 10px; text-align: left;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" style="padding: 20px; text-align: center;">Нет продуктов. Создайте первый продукт!</td>
                </tr>
            }
            else
            {
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="padding: 10px;">@p.Name</td>
                        <td style="padding: 10px;">@p.ProductionTimePerUnit</td>
                        <td style="padding: 10px;">@p.Category</td>
                        <td style="padding: 10px;">
                            <form method="post" asp-action="Delete" style="display:inline" onsubmit="return confirm('Удалить продукт @p.Name?')">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-danger" style="background: #e74c3c; color: white; border: none; padding: 5px 10px; border-radius: 4px;">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
