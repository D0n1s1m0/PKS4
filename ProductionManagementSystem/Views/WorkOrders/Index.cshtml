@model List<ProductionManagementSystem.Models.WorkOrder>
@{
    ViewData["Title"] = "Заказы";
}

<h1 style="color: #2c3e50;">Управление заказами</h1>

<a href="/WorkOrders/Create" style="display: inline-block; background: #3498db; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px; margin-bottom: 20px;">Создать заказ</a>

@if (TempData["Success"] != null)
{
    <div style="background: #d4edda; color: #155724; padding: 10px; border-radius: 5px; margin-bottom: 15px;">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div style="background: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px;">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <p>Нет заказов. <a href="/WorkOrders/Create">Создайте первый заказ</a></p>
}
else
{
    <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden;">
        <thead>
            <tr style="background: #2c3e50; color: white;">
                <th style="padding: 12px; text-align: left;">№</th>
                <th style="padding: 12px; text-align: left;">Продукт</th>
                <th style="padding: 12px; text-align: left;">Кол-во</th>
                <th style="padding: 12px; text-align: left;">Статус</th>
                <th style="padding: 12px; text-align: left;">Прогресс</th>
                <th style="padding: 12px; text-align: left;">Готовность</th>
                <th style="padding: 12px; text-align: left;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr id="order_@order.Id" style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 12px;">@order.Id</td>
                    <td style="padding: 12px;">@order.Product?.Name</td>
                    <td style="padding: 12px;">@order.Quantity</td>
                    <td style="padding: 12px;" id="status_@order.Id">
                        @if (order.Status == "Pending")
                        {
                            <span style="color: #f39c12; font-weight: bold;">⏳ В ожидании</span>
                        }
                        else if (order.Status == "InProgress")
                        {
                            <span style="color: #3498db; font-weight: bold;">⚙ В работе</span>
                        }
                        else if (order.Status == "Completed")
                        {
                            <span style="color: #27ae60; font-weight: bold;">✅ Завершен</span>
                        }
                        else
                        {
                            <span style="color: #e74c3c; font-weight: bold;">❌ Отменен</span>
                        }
                    </td>
                    <td style="padding: 12px; min-width: 250px;">
                        @if (order.Status == "InProgress")
                        {
                            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <div style="flex: 1; min-width: 150px; background: #e0e0e0; border-radius: 10px; height: 25px; overflow: hidden;">
                                    <div id="progress_bar_@order.Id" style="width: @order.Progress%; background: #27ae60; height: 100%; transition: width 0.3s; display: flex; align-items: center; justify-content: center; color: white; font-size: 12px; font-weight: bold;">
                                        <span id="progress_text_@order.Id">@order.Progress</span>%
                                    </div>
                                </div>
                                <div style="display: flex; gap: 5px; align-items: center;">
                                    <input type="number" 
                                           id="progress_input_@order.Id"
                                           min="0" 
                                           max="100" 
                                           value="@order.Progress" 
                                           style="width: 60px; padding: 5px; border: 1px solid #ddd; border-radius: 4px; text-align: center;" />
                                    <button onclick="updateProgress(@order.Id, parseInt(document.getElementById('progress_input_@order.Id').value))" 
                                            style="background: #3498db; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">
                                        Сохранить
                                    </button>
                                </div>
                            </div>
                        }
                        else if (order.Status == "Completed")
                        {
                            <div style="background: #27ae60; border-radius: 10px; height: 25px; width: 100%; overflow: hidden;">
                                <div style="width: 100%; background: #27ae60; height: 100%; text-align: center; color: white; font-weight: bold; line-height: 25px;">100%</div>
                            </div>
                        }
                        else
                        {
                            <span>0%</span>
                        }
                    </td>
                    <td style="padding: 12px;">
                        <span id="ready_time_@order.Id" style="font-weight: bold; color: #2c3e50;">
                            @if (order.Status == "InProgress")
                            {
                                @order.EstimatedEndDate.ToString("dd.MM.yyyy HH:mm")
                            }
                            else if (order.Status == "Completed")
                            {
                                <span style="color: #27ae60;">Готово</span>
                            }
                            else
                            {
                                <span style="color: #999;">—</span>
                            }
                        </span>
                    </td>
                    <td style="padding: 12px;">
                        @if (order.Status == "Pending")
                        {
                            <form method="post" asp-action="StartOrder" style="display: inline-block; margin-right: 5px;">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" style="background: #27ae60; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">▶ Запустить</button>
                            </form>
                        }
                        
                        @if (order.Status == "InProgress")
                        {
                            <form method="post" asp-action="CompleteOrder" style="display: inline-block; margin-right: 5px;">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" style="background: #3498db; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">✓ Завершить</button>
                            </form>
                        }
                        
                        @if (order.Status != "Completed" && order.Status != "Cancelled")
                        {
                            <form method="post" asp-action="CancelOrder" style="display: inline-block;">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" style="background: #e74c3c; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;" onclick="return confirm('Отменить заказ?')">✗ Отменить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<script>
    // Функция обновления прогресса через API
    function updateProgress(orderId, progress) {
        // Проверка на валидность
        if (isNaN(progress) || progress < 0) progress = 0;
        if (progress > 100) progress = 100;
        
        console.log("Отправка: заказ " + orderId + ", прогресс " + progress);
        
        fetch('/WorkOrders/UpdateProgress', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `id=${orderId}&progress=${progress}`
        })
        .then(response => response.json())
        .then(data => {
            console.log("Ответ:", data);
            if (data.success) {
                // Обновляем прогресс-бар
                document.getElementById(`progress_bar_${orderId}`).style.width = data.progress + '%';
                document.getElementById(`progress_text_${orderId}`).innerText = data.progress;
                document.getElementById(`progress_input_${orderId}`).value = data.progress;
                
                // Обновляем время готовности
                if (data.estimatedEndDate) {
                    document.getElementById(`ready_time_${orderId}`).innerHTML = data.estimatedEndDate;
                }
                
                if (data.progress >= 100) {
                    location.reload();
                }
            } else {
                alert("Ошибка обновления прогресса");
            }
        })
        .catch(error => console.error("Ошибка:", error));
    }
    
    // Автоматическое обновление прогресса каждые 2 секунды
    function autoRefreshProgress() {
        const rows = document.querySelectorAll('tr[id^="order_"]');
        rows.forEach(row => {
            const orderId = row.id.replace('order_', '');
            const statusSpan = document.getElementById(`status_${orderId}`);
            if (statusSpan && statusSpan.innerText.includes('В работе')) {
                fetch(`/WorkOrders/GetProgress?id=${orderId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'InProgress') {
                            const newProgress = data.progress;
                            const progressBar = document.getElementById(`progress_bar_${orderId}`);
                            const progressText = document.getElementById(`progress_text_${orderId}`);
                            const progressInput = document.getElementById(`progress_input_${orderId}`);
                            const readyTime = document.getElementById(`ready_time_${orderId}`);
                            
                            if (progressBar && progressText && parseInt(progressBar.style.width) !== newProgress) {
                                progressBar.style.width = newProgress + '%';
                                progressText.innerText = newProgress;
                                if (progressInput) progressInput.value = newProgress;
                            }
                            
                            if (readyTime && data.estimatedEndDate) {
                                readyTime.innerHTML = data.estimatedEndDate;
                            }
                            
                            if (data.progress >= 100) {
                                location.reload();
                            }
                        } else if (data.status === 'Completed') {
                            location.reload();
                        }
                    });
            }
        });
    }
    
    // Запускаем автообновление каждые 2 секунды
    setInterval(autoRefreshProgress, 2000);
</script>

<p style="margin-top: 20px; color: #666; font-size: 12px;">
    🔄 Прогресс обновляется автоматически каждые 2 секунды<br>
    📝 Введите процент готовности и нажмите "Сохранить" - время готовности пересчитается<br>
    ⏱ В столбце "Готовность" отображается дата и время завершения заказа
</p>
