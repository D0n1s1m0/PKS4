@{
    ViewData["Title"] = Model.Name;
}
@model Attraction

<div style="background: white; border-radius: 8px; padding: 2rem;">
    <h1>@Model.Name</h1>
    
    <div class="detail-image">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px;" onerror="this.src='https://via.placeholder.com/800x400?text=No+Image'" />
        }
        else
        {
            <div style="background: #ddd; height: 300px; display: flex; align-items: center; justify-content: center; border-radius: 8px;">🏛 @Model.Name</div>
        }
    </div>

    <div class="info-row">
        <strong>Город:</strong> <a href="/Cities/Details/@Model.CityId">@Model.City?.Name</a>
    </div>
    <div class="info-row">
        <strong>Часы работы:</strong> @Model.WorkingHours
    </div>
    <div class="info-row">
        <strong>Стоимость посещения:</strong> @Model.Price
    </div>
    <div class="info-row">
        <strong>История:</strong> @Model.History
    </div>

    <a href="/Cities/Details/@Model.CityId" class="back-link">← Назад к городу @Model.City?.Name</a>
</div>
