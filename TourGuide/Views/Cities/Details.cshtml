@{
    ViewData["Title"] = Model.Name;
}
@model City

<div style="background: white; border-radius: 8px; padding: 2rem;">
    <h1>@Model.Name</h1>
    
    <div class="detail-image">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px;" onerror="this.src='https://via.placeholder.com/800x400?text=No+Image'" />
        }
        else
        {
            <div style="background: #ddd; height: 300px; display: flex; align-items: center; justify-content: center; border-radius: 8px;">🏙 @Model.Name</div>
        }
    </div>

    <div class="info-row">
        <strong>Регион:</strong> @Model.Region
    </div>
    <div class="info-row">
        <strong>Население:</strong> @Model.Population.ToString("N0") человек
    </div>
    <div class="info-row">
        <strong>Герб:</strong> @Model.CoatOfArms
    </div>
    <div class="info-row">
        <strong>История:</strong> @Model.History
    </div>

    <h2 style="margin: 2rem 0 1rem 0;">Достопримечательности (@(Model.Attractions?.Count ?? 0))</h2>

    @if (Model.Attractions != null && Model.Attractions.Any())
    {
        <div class="attractions-list">
            @foreach (var attraction in Model.Attractions)
            {
                <div class="attraction-card">
                    <div class="attraction-img">
                        @if (!string.IsNullOrEmpty(attraction.ImageUrl))
                        {
                            <img src="@attraction.ImageUrl" alt="@attraction.Name" style="width: 100%; height: 160px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/300x160?text=No+Image'" />
                        }
                        else
                        {
                            <div style="height: 160px; display: flex; align-items: center; justify-content: center;">🏛 @attraction.Name</div>
                        }
                    </div>
                    <div class="attraction-content">
                        <h3>@attraction.Name</h3>
                        <p style="color: #666; font-size: 0.9rem;">@attraction.ShortDescription</p>
                        <a href="/Attractions/Details/@attraction.Id" class="btn">Подробнее</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>В этом городе пока нет достопримечательностей.</p>
    }

    <a href="/Cities" class="back-link">← Назад к списку городов</a>
</div>
